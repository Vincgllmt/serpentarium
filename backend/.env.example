# Dossier contenant les ROMs (jamais commit, voir roms/ a la racine du repo)
ROMS_DIR=../roms

# Base SQLite locale
DB_PATH=./data/library.db

# Sous-dossier de ROMS_DIR a exclure du scan (emulateurs, firmwares, cles...)
EMULATORS_DIRNAME=emulator

# Identifiants ScreenScraper.fr (compte dev a demander sur screenscraper.fr,
# ssid/sspassword = ton compte utilisateur ScreenScraper)
SS_DEVID=
SS_DEVPASSWORD=
SS_SOFTNAME=serpentarium
SS_SSID=
SS_SSPASSWORD=

# Optionnel : api2.screenscraper.fr a des soucis DNS recurrents, www.screenscraper.fr
# sert le meme /api2/*. Delai mini (s) entre deux requetes SS (compte non-donateur
# = 1 seul thread autorise, on serialise pour ne pas se faire jeter).
# SS_BASE_URL=https://www.screenscraper.fr/api2
# SS_MIN_INTERVAL_SECONDS=2.0

# Dossier de cache local des jaquettes (telechargees une seule fois puis servies
# par notre propre API, pour ne pas re-solliciter ScreenScraper/IGDB a chaque affichage)
# COVERS_DIR=./data/covers

# Identifiants IGDB (console developpeur Twitch, libre-service) :
# https://dev.twitch.tv/console/apps -> creer une app -> Client ID + Client Secret
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
